---
import SkillPage from '@/components/l10n/SkillPage.astro';
import { NEW_LOCALES } from '@/lib/new-locales';
import { skills } from '@/lib/static-content';
import { skillIdsFor } from '@/lib/skill-class';
export function getStaticPaths() {
  return NEW_LOCALES.flatMap((lang) => {
    const ok = new Set(skillIdsFor(lang));
    return skills.filter((s) => ok.has(s.id)).map((skill) => ({ params: { lang, id: skill.id }, props: { skill } }));
  });
}
const { lang } = Astro.params;
const { skill } = Astro.props;
---
<SkillPage locale={lang as any} skill={skill} />
