---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import UpdatesContent from '@/components/UpdatesContent.astro';
import { t } from '@/lib/ui-strings';
import { NEW_LOCALES } from '@/lib/new-locales';
export function getStaticPaths() { return NEW_LOCALES.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as any;
---
<Layout title={t(lang, 'updatesTitle')} description={t(lang, 'updatesDesc')}>
  <Header />
  <main class="container mx-auto px-3 sm:px-4 py-4 sm:py-8">
    <Breadcrumb items={[{ label: t(lang, 'updatesH1') }]} />
    <div class="mb-6 sm:mb-8">
      <h1 class="text-3xl sm:text-4xl font-display gradient-text mb-3 sm:mb-4">{t(lang, 'updatesH1')}</h1>
      <p class="text-gray-600">{t(lang, 'updatesSub')}</p>
    </div>
    <UpdatesContent locale={lang} />
  </main>
</Layout>
