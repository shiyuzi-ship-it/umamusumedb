---
import EntityListPage from '@/components/l10n/EntityListPage.astro';
import { NEW_LOCALES } from '@/lib/new-locales';
export function getStaticPaths() { return NEW_LOCALES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
---
<EntityListPage locale={lang as any} kind="cards" page={1} />
