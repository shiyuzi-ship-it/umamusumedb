---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { skills } from '@/lib/static-content';
import { Search, Sparkles, Filter } from 'lucide-react';

const rarities = [
  { value: 'normal', label: '通常（白）' },
  { value: 'gold', label: 'レア（金）' },
  { value: 'unique', label: '固有' },
  { value: 'evolved', label: '進化' }
] as const;
---

<Layout
  title="スキル - UmamusumeDB"
  description="ウマ娘のスキル一覧。効果・発動条件・レアリティを確認し、キャラ/サポカとの相互リンクも参照できます。"
>
  <Header />

  <main class="container mx-auto px-3 sm:px-4 py-4 sm:py-8">
    <Breadcrumb items={[{ label: 'スキル' }]} />

    <div class="mb-6 sm:mb-8">
      <h1 class="text-3xl sm:text-4xl font-display gradient-text mb-3 sm:mb-4">スキル</h1>
      <p class="text-sm sm:text-base text-gray-600">
        全 {skills.length} 件。英/日名称、発動条件、効果テキストで検索できます。
      </p>
    </div>

    <!-- Filters and Search -->
    <div class="glass rounded-xl p-4 mb-8">
      <div class="flex flex-col md:flex-row gap-4">
        <div class="flex-1 relative">
          <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" />
          <input
            type="text"
            id="skill-search"
            placeholder="スキルを検索..."
            class="w-full pl-10 pr-4 py-2 rounded-lg border border-uma-primary/20 bg-white/50 focus:outline-none focus:border-uma-primary"
          />
        </div>

        <select id="rarity-filter" class="px-4 py-2 rounded-lg border border-uma-primary/20 bg-white/50">
          <option value="all">全レアリティ</option>
          {rarities.map((r) => (
            <option value={r.value}>{r.label}</option>
          ))}
        </select>

        <select id="type-filter" class="px-4 py-2 rounded-lg border border-uma-primary/20 bg-white/50">
          <option value="all">全タイプ</option>
          <option value="unique">固有</option>
          <option value="common">通常・レア</option>
          <option value="evolved">進化</option>
        </select>
      </div>
    </div>

    <div id="skills-container" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-6">
      {skills.map((skill) => (
        <a
          href={`/ja/skills/${skill.id}/`}
          style="content-visibility:auto;contain-intrinsic-size:auto 150px"
          class="skill-item bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-uma-primary/10 p-5 block"
          data-search={`${skill.name_en} ${skill.name_jp || ''} ${skill.effect || ''} ${skill.trigger_condition || ''}`.toLowerCase()}
          data-rarity={skill.rarity || ''}
          data-type={(skill.skill_type || '').toLowerCase()}
        >
          <div class="flex items-start justify-between gap-3">
            {skill.icon_url && <img src={skill.icon_url} alt="" width="32" height="32" loading="lazy" class="w-8 h-8 rounded flex-shrink-0" />}
            <div class="flex-1 min-w-0">
              <h2 class="font-bold text-lg">{skill.name_jp || skill.name_en}</h2>
              <div class="text-sm text-gray-600">{skill.name_en}</div>
            </div>
            <div class="flex flex-col items-end gap-2">
              {skill.rarity && (
                <span class="text-xs px-2 py-1 rounded-full bg-uma-primary/10 text-uma-primary font-bold">
                  {skill.rarity}
                </span>
              )}
              {skill.server === 'jp' && (
                <span class="text-[10px] px-2 py-0.5 rounded-full bg-gray-800/80 text-white font-semibold">日本版のみ</span>
              )}
            </div>
          </div>

          <div class="mt-3 text-sm text-gray-700">
            <div class="flex items-center gap-2 text-gray-600">
              <Sparkles className="w-4 h-4 text-uma-accent" />
              <span class="truncate">{skill.description_jp || skill.effect || skill.description_en || '—'}</span>
            </div>
            {skill.trigger_condition && (
              <div class="flex items-center gap-2 mt-2 text-gray-500">
                <Filter className="w-4 h-4" />
                <span class="truncate">{skill.trigger_condition}</span>
              </div>
            )}
          </div>
        </a>
      ))}
    </div>

    <div id="no-results" class="hidden text-center py-12">
      <p class="text-xl text-gray-500">条件に一致するスキルが見つかりません</p>
    </div>
  </main>

  <script>
    const searchInput = document.getElementById('skill-search') as HTMLInputElement;
    const rarityFilter = document.getElementById('rarity-filter') as HTMLSelectElement;
    const typeFilter = document.getElementById('type-filter') as HTMLSelectElement;
    const container = document.getElementById('skills-container');
    const noResults = document.getElementById('no-results');

    function filterSkills() {
      const q = searchInput?.value.toLowerCase().trim() || '';
      const rarity = rarityFilter?.value || 'all';
      const type = typeFilter?.value || 'all';

      let has = false;
      document.querySelectorAll('.skill-item').forEach((item) => {
        const haystack = item.getAttribute('data-search') || '';
        const itemRarity = item.getAttribute('data-rarity') || '';
        const itemType = item.getAttribute('data-type') || '';

        const matchesSearch = !q || haystack.includes(q);
        const matchesRarity = rarity === 'all' || itemRarity === rarity;
        const matchesType = type === 'all' || itemType === type;

        const show = matchesSearch && matchesRarity && matchesType;
        (item as HTMLElement).style.display = show ? '' : 'none';
        if (show) has = true;
      });

      if (noResults) noResults.classList.toggle('hidden', has);
      if (container) container.classList.toggle('hidden', !has);
    }

    searchInput?.addEventListener('input', filterSkills);
    rarityFilter?.addEventListener('change', filterSkills);
    typeFilter?.addEventListener('change', filterSkills);
  </script>
</Layout>







