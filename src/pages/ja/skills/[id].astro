---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { characters, supportCards, skills } from '@/lib/static-content';
import type { Skill } from '@/types';
import { skillClass, duplicateSkillNameEn } from '@/lib/skill-class';
import { Sparkles, Info, Zap, Users } from 'lucide-react';

export function getStaticPaths() {
  return skills.map((skill) => ({
    params: { id: skill.id },
    props: { skill }
  }));
}

const { skill } = Astro.props as { skill: Skill };

const norm = (s: string) =>
  String(s ?? '')
    .trim()
    .toLowerCase();

const skillNames = new Set([norm(skill.name_en), norm(skill.name_jp || '')].filter(Boolean));

const linkedCards = supportCards.filter((card) =>
  (card.skills || []).some((name) => skillNames.has(norm(name)))
);

const linkedCharacters = characters.filter((c) => {
  const unique = c.unique_skill?.name_en ? norm(c.unique_skill.name_en) : '';
  const uniqueJp = c.unique_skill?.name_jp ? norm(c.unique_skill.name_jp) : '';
  if (unique && skillNames.has(unique)) return true;
  if (uniqueJp && skillNames.has(uniqueJp)) return true;
  return (c.awakening_skills || []).some((s) => skillNames.has(norm(s)));
});
---

<Layout
  noindex={skillClass.get(skill.id) === 'none'}
  title={`${skill.name_jp || skill.name_en}${duplicateSkillNameEn.has(skill.name_en) ? ` (${skill.name_en})` : ''} - スキル効果・必要Pt | UmamusumeDB`}
  description={`${skill.name_jp || skill.name_en}: ${String(skill.description_jp || skill.description_en || 'ウマ娘のスキル詳細').slice(0, 110)}`}
  image={skill.icon_url}
>
  <Header />

  <main class="container mx-auto px-3 sm:px-4 py-4 sm:py-8">
    <Breadcrumb items={[{ label: 'スキル', href: '/ja/skills/' }, { label: skill.name_jp || skill.name_en }]} />

    <div class="grid lg:grid-cols-3 gap-6 sm:gap-8">
      <!-- Left: Skill summary -->
      <div class="lg:col-span-1">
        <div class="glass rounded-xl p-6 sticky top-20">
          <div class="flex items-center gap-3">
            {skill.icon_url && <img src={skill.icon_url} alt="" width="40" height="40" loading="lazy" class="w-10 h-10 rounded" />}
            <h1 class="text-2xl font-display gradient-text">{skill.name_jp || skill.name_en}</h1>
          </div>
          <p class="text-gray-600 mt-1">{skill.name_en}</p>

          <div class="mt-4 flex flex-wrap gap-2">
            {skill.rarity && (
              <span class="text-xs px-3 py-1.5 rounded-full bg-uma-primary/10 text-uma-primary font-bold">
                {skill.rarity}
              </span>
            )}
            {skill.skill_type && (
              <span class="text-xs px-3 py-1.5 rounded-full bg-gray-100 text-gray-700 uppercase">
                {skill.skill_type}
              </span>
            )}
            {typeof skill.cost === 'number' && (
              <span class="text-xs px-3 py-1.5 rounded-full bg-uma-accent/10 text-uma-dark">
                SP {skill.cost}
              </span>
            )}
          </div>

          <div class="mt-5 space-y-3 text-sm text-gray-700">
            <div class="flex items-start gap-2">
              <Sparkles className="w-4 h-4 text-uma-accent mt-0.5" />
              <div>
                <div class="text-gray-500 text-xs uppercase tracking-wide">効果</div>
                <div class="font-medium">{skill.description_jp || skill.effect || skill.description_en || '—'}</div>
              </div>
            </div>
            {skill.trigger_condition && (
              <div class="flex items-start gap-2">
                <Info className="w-4 h-4 text-uma-primary mt-0.5" />
                <div>
                  <div class="text-gray-500 text-xs uppercase tracking-wide">発動条件</div>
                  <div class="font-medium">{skill.trigger_condition}</div>
                </div>
              </div>
            )}
            <div class="grid grid-cols-2 gap-3">
              {skill.duration && (<div class="bg-white rounded-lg p-3 border border-uma-primary/10">
                <div class="text-xs text-gray-500">持続</div>
                <div class="font-semibold">{skill.duration || '—'}</div>
              </div>)}
              {skill.cooldown && (<div class="bg-white rounded-lg p-3 border border-uma-primary/10">
                <div class="text-xs text-gray-500">クールダウン</div>
                <div class="font-semibold">{skill.cooldown || '—'}</div>
              </div>)}
              {skill.activation_rate && (<div class="bg-white rounded-lg p-3 border border-uma-primary/10">
                <div class="text-xs text-gray-500">発動率</div>
                <div class="font-semibold">{skill.activation_rate || '—'}</div>
              </div>)}
              <div class="bg-white rounded-lg p-3 border border-uma-primary/10">
                <div class="text-xs text-gray-500">ID</div>
                <div class="font-mono text-xs">{skill.id}</div>
              </div>
            </div>
          </div>

          <div class="mt-6 text-sm">
            <a href="/ja/tools/skill-builder/" class="text-uma-primary hover:underline inline-flex items-center gap-2">
              <Zap className="w-4 h-4" />
              スキルビルダーを開く
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Cross-links -->
      <div class="lg:col-span-2 space-y-6">
        <div class="glass rounded-xl p-6">
          <h2 class="text-xl font-display mb-4 flex items-center gap-2">
            <Users className="w-5 h-5 text-uma-primary" />
            関連キャラ
            <span class="text-sm text-gray-500 font-normal">({linkedCharacters.length})</span>
          </h2>
          {linkedCharacters.length ? (
            <ul class="grid sm:grid-cols-2 gap-2 text-sm">
              {linkedCharacters.slice(0, 40).map((c) => (
                <li><a href={`/ja/characters/${c.id}/`} class="text-uma-primary hover:underline">{c.name_jp || c.name_en}</a></li>
              ))}
              {linkedCharacters.length > 40 && <li class="text-gray-500">…ほか {linkedCharacters.length - 40} 件</li>}
            </ul>
          ) : (
            <p class="text-gray-600 text-sm">このスキルに紐づくキャラはありません。</p>
          )}
        </div>

        <div class="glass rounded-xl p-6">
          <h2 class="text-xl font-display mb-4 flex items-center gap-2">
            <Sparkles className="w-5 h-5 text-uma-secondary" />
            関連サポカ
            <span class="text-sm text-gray-500 font-normal">({linkedCards.length})</span>
          </h2>
          {linkedCards.length ? (
            <ul class="grid sm:grid-cols-2 gap-2 text-sm">
              {linkedCards.slice(0, 40).map((c) => (
                <li><a href={`/ja/cards/${c.id}/`} class="text-uma-primary hover:underline">{c.name_jp || c.name_en} <span class="text-gray-400">({c.rarity})</span></a></li>
              ))}
              {linkedCards.length > 40 && <li class="text-gray-500">…ほか {linkedCards.length - 40} 件</li>}
            </ul>
          ) : (
            <p class="text-gray-600 text-sm">このスキルに紐づくサポカはありません。</p>
          )}
        </div>
      </div>
    </div>
  </main>
</Layout>


