---
import RelatedLinks from '@/components/l10n/RelatedLinks.astro';
import { t as __t } from '@/lib/ui-strings';
import { charName as __cn, cardName as __kn } from '@/lib/localized.js';
import { otherOutfits as __outfits, cardsOfCharacter as __cardsOf, otherCardsOfCharacter as __otherCards, characterOfCard as __ownerOf } from '@/lib/related';
import { localizePathname as __lp } from '@/lib/i18n';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import { supportCards, skills } from '@/lib/static-content';
import { createSkillIndex, findSkillIdByName } from '@/lib/skill-lookup';
import { effectAtMax, effectLabel, effectSuffix, maxLevelFor, serverLabel } from '@/lib/game-format';
import { Star, Zap, Heart, Brain, Shield, Sparkles, Users, TrendingUp, Award } from 'lucide-react';

export function getStaticPaths() {
  return supportCards.map((card) => ({
    params: { id: card.id },
    props: { card },
  }));
}

const { card } = Astro.props;
const skillIndex = createSkillIndex(skills);

// Type colors and icons
const typeConfig = {
  speed: { color: 'bg-red-500', icon: Zap, label: 'Speed' },
  stamina: { color: 'bg-green-500', icon: Heart, label: 'Stamina' },
  power: { color: 'bg-orange-500', icon: Sparkles, label: 'Power' },
  guts: { color: 'bg-purple-500', icon: Star, label: 'Guts' },
  wisdom: { color: 'bg-blue-500', icon: Brain, label: 'Wisdom' },
  friend: { color: 'bg-pink-500', icon: Users, label: 'Friend' },
  group: { color: 'bg-teal-500', icon: Users, label: 'Group' }
};

const config = typeConfig[card.type as keyof typeof typeConfig] || typeConfig.speed;
const TypeIcon = config.icon;

// Rarity colors
const rarityColors = {
  SSR: 'bg-gradient-to-r from-yellow-400 to-yellow-600',
  SR: 'bg-gradient-to-r from-purple-400 to-purple-600',
  R: 'bg-gradient-to-r from-gray-400 to-gray-600'
};

const maxLevel = maxLevelFor(card);
const toMap = (v: any): Record<string, number> => v;
const extractEffectValue = (value: any) => effectAtMax(value, maxLevel);
const skillByName = new Map(skills.map((sk) => [sk.name_en, sk]));

const effectHighlights = Object.entries(card.effects || {})
  .map(([key, value]) => ({
    key,
    value,
    display: extractEffectValue(value)
  }))
  .filter(entry => entry.display > 0)
  .sort((a, b) => b.display - a.display)
  .slice(0, 3);
const __loc = 'en' as const;
const __owner = __ownerOf(card);
const __relOwner = __owner ? [{ href: __lp(`/characters/${__owner.id}/`, __loc), name: __cn(__owner, __loc), image: __owner.image_url }] : [];
const __relCards = __otherCards(card).map((c: any) => ({ href: __lp(`/cards/${c.id}/`, __loc), name: __kn(c, __loc), image: c.image_url, sub: c.rarity + (c.server === 'jp' ? ' · ' + __t(__loc, 'jpOnly') : '') }));

---

<Layout
  title={`${card.name_en} (${card.rarity} ${config.label}) - Support Card Guide | UmamusumeDB`}
  description={`${card.name_en} (${card.rarity} ${config.label}) support card for Uma Musume Pretty Derby: effects by level, hint skills and release dates (JP ${card.release_date_jp ?? 'n/a'} / Global ${card.release_date_global ?? 'not yet released'}).`}
  image={card.image_url || 'https://umamusumedb.com/og-image.png'}
  structuredDataType="supportCard"
  structuredData={{
    id: card.id,
    name_en: card.name_en,
    name_ja: card.name_jp,
    image_url: card.image_url,
    rarity: card.rarity,
    type: card.type,
    effects: card.effects
  }}
>
  <Header />
  
  <main class="container mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="text-sm mb-6">
      <ol class="flex items-center space-x-2">
        <li><a href="/" class="text-uma-primary hover:underline">Home</a></li>
        <li class="text-gray-400">/</li>
        <li><a href="/cards/" class="text-uma-primary hover:underline">Support Cards</a></li>
        <li class="text-gray-400">/</li>
        <li class="text-gray-600">{card.name_en}</li>
      </ol>
    </nav>

    <div class="grid lg:grid-cols-3 gap-8">
      <!-- Left Column - Card Image and Basic Info -->
      <div class="lg:col-span-1">
        <div class="glass rounded-xl p-6 sticky top-20">
          <!-- Card Image -->
          <div class="relative aspect-[3/4] bg-gradient-to-br from-uma-primary/20 to-uma-secondary/20 rounded-lg mb-4 overflow-hidden">
            <!-- Rarity Badge -->
            <div class={`absolute top-3 left-3 z-10 px-3 py-1 rounded-full text-white font-bold text-sm ${rarityColors[card.rarity as keyof typeof rarityColors]}`}>
              {card.rarity}
            </div>
            
            <!-- Type Badge -->
            <div class={`absolute top-3 right-3 z-10 w-12 h-12 rounded-full ${config.color} flex items-center justify-center`}>
              <TypeIcon className="w-6 h-6 text-white" />
            </div>

            {(card.character_image_url || card.image_url) ? (
              <img 
                src={card.character_image_url || card.image_url} 
                alt={card.name_en}
                class="absolute inset-0 w-full h-full object-contain object-center"
                loading="lazy"
              />
            ) : (
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="text-center">
                  <div class="w-32 h-32 mx-auto mb-4 bg-gradient-to-br from-uma-primary to-uma-secondary rounded-full flex items-center justify-center">
                    <TypeIcon className="w-16 h-16 text-white" />
                  </div>
                  <p class="text-gray-500">Support Card Image</p>
                </div>
              </div>
            )}
          </div>

          <!-- Basic Info -->
          <div class="space-y-3">
            <h1 class="text-2xl font-display gradient-text">{card.name_en}</h1>
            <p class="text-lg font-jp text-gray-600">{card.name_jp}</p>
            
            <!-- Type and Rarity -->
            <div class="flex items-center gap-4">
              <div class="flex items-center gap-2">
                <TypeIcon className="w-5 h-5 text-uma-primary" />
                <span class="font-medium">{config.label}</span>
              </div>
              <div class={`px-3 py-1 rounded-full text-white text-xs font-bold ${rarityColors[card.rarity as keyof typeof rarityColors]}`}>
                {card.rarity}
              </div>
            </div>
            <dl class="text-xs text-gray-600 space-y-1">
              <div class="flex justify-between"><dt>Server</dt><dd class="font-medium">{serverLabel(card.server)}</dd></div>
              {card.release_date_jp && <div class="flex justify-between"><dt>JP release</dt><dd>{card.release_date_jp}</dd></div>}
              {card.release_date_global && <div class="flex justify-between"><dt>Global release</dt><dd>{card.release_date_global}</dd></div>}
              <div class="flex justify-between"><dt>Max level</dt><dd>Lv.{maxLevel} (LB4)</dd></div>
            </dl>
          </div>
        </div>
      </div>

      <!-- Right Column - Detailed Effects -->
      <div class="lg:col-span-2 space-y-6">
        {effectHighlights.length > 0 && (
          <div class="grid md:grid-cols-3 gap-3">
            {effectHighlights.map(({ key, display }) => (
              <div class="bg-white rounded-lg shadow-sm border border-uma-primary/10 p-4">
                <div class="text-xs uppercase tracking-wide text-gray-500">Key Effect</div>
                <div class="text-sm font-semibold text-gray-800 mt-1">{effectLabel(key)}</div>
                <div class="text-2xl font-bold text-uma-primary mt-2">+{display}{effectSuffix(key)}</div>
              </div>
            ))}
          </div>
        )}

        <!-- Main Effects Section -->
        <div class="glass rounded-xl p-6">
          <h2 class="text-xl font-display mb-4 flex items-center gap-2">
            <TrendingUp className="w-5 h-5 text-uma-primary" />
            Training Effects
          </h2>
          
          <div class="grid md:grid-cols-2 gap-4">
            {Object.entries(card.effects || {}).map(([key, value]) => {
              const levels = Object.keys(toMap(value))
                .map((k) => Number(k.replace('lv', '')))
                .sort((x, y) => x - y);
              const displayValue = extractEffectValue(value);
              const suffix = effectSuffix(key);

              return (
                <div class="bg-white rounded-lg p-4">
                  <div class="flex justify-between items-center mb-2">
                    <span class="text-sm text-gray-600">{effectLabel(key)}</span>
                    <span class="text-lg font-bold text-uma-primary">+{displayValue}{suffix}</span>
                  </div>
                  <div class="text-xs text-gray-500 space-y-1">
                    {levels.map((lv) => (
                      <div class="flex justify-between">
                        <span>Lv.{lv}:</span>
                        <span class={lv === maxLevel ? 'font-bold text-uma-primary' : ''}>+{toMap(value)[`lv${lv}`]}{suffix}</span>
                      </div>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
          <p class="mt-4 text-xs text-gray-500">Values include the card's unique effect from the level it unlocks. Intermediate levels are interpolated the same way the game does.</p>
        </div>

        <!-- Skills Section -->
        <div class="glass rounded-xl p-6">
          <h2 class="text-xl font-display mb-4 flex items-center gap-2">
            <Zap className="w-5 h-5 text-uma-primary" />
            Skills &amp; Hints
          </h2>
          
          <div class="grid gap-3">
            {card.skills?.map((skillName: string) => {
              const skillId = findSkillIdByName(skillIndex, skillName);
              return (
              <div class="flex items-center gap-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
                <div class={`w-10 h-10 ${config.color} bg-opacity-20 rounded-full flex items-center justify-center`}>
                  <Zap className={`w-5 h-5 text-${config.color.replace('bg-', '')}`} />
                </div>
                <div class="flex-1">
                  <h3 class="font-semibold">
                    {skillId ? (
                      <a href={`/skills/${skillId}/`} class="text-uma-primary hover:underline">
                        {skillName}
                      </a>
                    ) : (
                      skillName
                    )}
                  </h3>
                  <p class="text-sm text-gray-600">{skillByName.get(skillName)?.description_en || ''}</p>
                </div>
                <div class="text-xs px-2 py-1 bg-gray-100 rounded-full">
                  {(card.event_skills ?? []).includes(skillName) ? 'Event' : 'Hint'}
                </div>
              </div>
              );
            })}
          </div>
        </div>

        <!-- Events Section -->
        {card.events && card.events.length > 0 && (
          <div class="glass rounded-xl p-6">
            <h2 class="text-xl font-display mb-4 flex items-center gap-2">
              <Award className="w-5 h-5 text-uma-primary" />
              Unique Events
            </h2>
            
            <div class="space-y-3">
              {card.events.map((event: string, index: number) => (
                <div class="flex items-start gap-3 p-3 bg-white rounded-lg">
                  <div class="w-8 h-8 bg-uma-accent/20 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                    <span class="text-sm font-bold text-uma-accent">{index + 1}</span>
                  </div>
                  <div>
                    <h3 class="font-semibold">{event}</h3>
                    <p class="text-sm text-gray-600 mt-1">
                      Trigger this event for additional training bonuses
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

      </div>
    </div>
    <div class="mt-8 space-y-6">
      <RelatedLinks title={__t(__loc, 'characterOutfits')} items={__relOwner} />
      <RelatedLinks title={__t(__loc, 'relatedCardsOther')} items={__relCards} />
    </div>
  </main>

  <style>
    .prose ul {
      @apply list-disc list-inside space-y-1;
    }
  </style>
</Layout>
