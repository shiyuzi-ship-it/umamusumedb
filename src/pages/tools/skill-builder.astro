---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import SkillBuilder from '@/components/tools/SkillBuilder';
---

<Layout
  title="Skill Builder - UmamusumeDB"
  description="Build optimal skill combinations for your Uma Musume"
  structuredDataType="tool"
  structuredData={{
    name: 'Skill Builder',
    description: 'Plan skill purchases with real skill costs, hint discounts and a Skill Point budget.',
    url: '/tools/skill-builder/'
  }}
>
  <Header />

  <main class="container mx-auto px-3 sm:px-4 py-4 sm:py-8">
    <Breadcrumb items={[{ label: 'Tools', href: '/tools/' }, { label: 'Skill Builder' }]} />

    <div class="mb-6 sm:mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold mb-3 sm:mb-4">Skill Combination Builder</h1>
      <p class="text-sm sm:text-base text-gray-600">
        Plan skill purchases with real skill costs, hint discounts and a Skill Point budget.
      </p>
    </div>

    <SkillBuilder client:load />
  </main>
</Layout>