---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
---

<Layout
  title="Page not found | UmamusumeDB"
  description="This page does not exist on UmamusumeDB."
  noindex={true}
>
  <Header />
  <main class="container mx-auto px-4 py-16 text-center">
    <h1 class="text-4xl font-display gradient-text mb-3">404</h1>
    <p class="text-gray-600 mb-6">This page does not exist. It may have been moved or removed.</p>
    <div class="flex flex-wrap justify-center gap-3 text-sm">
      <a href="/" class="px-4 py-2 rounded-lg bg-uma-primary text-white hover:opacity-90">Home</a>
      <a href="/characters/" class="px-4 py-2 rounded-lg bg-white border hover:bg-gray-50">Characters</a>
      <a href="/cards/" class="px-4 py-2 rounded-lg bg-white border hover:bg-gray-50">Support cards</a>
      <a href="/updates/" class="px-4 py-2 rounded-lg bg-white border hover:bg-gray-50">Updates</a>
      <a href="/tools/" class="px-4 py-2 rounded-lg bg-white border hover:bg-gray-50">Tools</a>
    </div>
  </main>
</Layout>
