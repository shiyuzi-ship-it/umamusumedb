---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
const title = '今日卡包';
const description = '每日免费一包，随机一张纪念闪卡，带唯一编号。可保存、可分享。非官方同人预览，Artwork © Cygames, Inc.';
---
<Layout
  title={title}
  description={description}
  image="https://umamusumedb.com/holo/og/pack.webp"
  largeOg={true}
  structuredDataType="tool"
  structuredData={{ name: title, description, url: 'https://umamusumedb.com/zh/tools/daily-pack/' }}
>
  <Header />
  <main class="container mx-auto px-3 sm:px-4 py-4 sm:py-8 max-w-3xl">
    <Breadcrumb items={[{ label: '工具', href: '/zh/tools/' }, { label: '今日卡包' }]} />
    <h1 class="text-3xl font-display gradient-text mb-3">今日卡包</h1>
    <p class="text-gray-700 mb-6">{description}</p>
    <p class="mb-8">
      <a href="/zh/holo/" class="inline-block px-5 py-3 rounded-full font-semibold text-amber-950" style="background:linear-gradient(135deg,#f3d48a,#e0b15a)">拆开今日卡包</a>
    </p>
    <div class="bg-white rounded-xl shadow p-5 sm:p-6 space-y-4 text-gray-700 leading-relaxed">
      <h2 class="text-xl font-semibold text-gray-900">怎么玩</h2>
      <ul class="list-disc pl-5 space-y-2">
        <li>每天（以北京时间日期为准）可以免费拆开一包，随机得到一张全息纪念闪卡。</li>
        <li>每张卡都有唯一编号，格式为 <code class="text-sm bg-gray-100 px-1 rounded">UMA-年月日-XXXX</code>。</li>
        <li>拆完可以保存纪念图、复制分享链接，也可以回到对应角色资料页。</li>
        <li>不需要登录，没有付费补包，不会改变第二天的卡片。</li>
        <li>连续拆包会显示「第 N 日」；连续 7 日会解锁一枚装饰框（只是纪念外观，不是稀有度）。</li>
        <li>如果有人通过你的分享链接完成当天的拆包，你的「传递」计数会增加一次（同一人每天最多一次）。传递不会额外发包装、也不会改变出现概率。</li>
      </ul>
      <h2 class="text-xl font-semibold text-gray-900 pt-2">当前卡池</h2>
      <p>软上线阶段只有三张：谋勇兼备（白光のレガリア）、特别周（特别梦想家）、黄金船（火红斗争）。均为游戏官方立绘的同人全息预览。</p>
      <h2 class="text-xl font-semibold text-gray-900 pt-2">说明</h2>
      <p>本功能是 umamusumedb.com 的非官方同人预览，与 Cygames, Inc. 及《赛马娘 Pretty Derby》官方无关，不是官方周边或数字藏品。角色立绘版权归 © Cygames, Inc. 所有。</p>
    </div>
  </main>
</Layout>
