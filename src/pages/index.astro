---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import CharacterCard from '@/components/CharacterCard';
import SupportCardCard from '@/components/SupportCardCard';
import { characters, supportCards, skills } from '@/lib/static-content';
import releasesData from '../../public/data/releases.json';
import scenariosData from '../../public/data/scenarios.json';
import { Search, Users, Sparkles, Star, Calculator, TrendingUp, Newspaper } from 'lucide-react';

const releases = (releasesData as any).releases as any[];
const latestGlobal = releases.filter((r) => r.server === 'global').slice(0, 12);
const globalOnly = (item: any) => item.server !== 'jp';
// Newest by Global release date (characters.json / supportCards.json are ordered by id, not date)
const byGlobalRelease = (a: any, b: any) =>
  String(b.release_date_global ?? '').localeCompare(String(a.release_date_global ?? '')) ||
  (b.card_id ?? b.support_id ?? 0) - (a.card_id ?? a.support_id ?? 0);
const newestCharacters = characters.filter(globalOnly).sort(byGlobalRelease).slice(0, 12);
const newestCards = supportCards.filter((c: any) => globalOnly(c) && c.rarity === 'SSR').sort(byGlobalRelease).slice(0, 12);
const globalCharacterCount = characters.filter(globalOnly).length;
const globalCardCount = supportCards.filter(globalOnly).length;
const dataDate = (releasesData as any).generatedAt.slice(0, 10);
---

<Layout 
  title="UmamusumeDB - #1 Database for Uma Musume Pretty Derby"
  description="UmamusumeDB is the most comprehensive database for Uma Musume Pretty Derby. Find characters, support cards, skills, release dates and training calculators for the Global and JP servers.">
  <Header />
  
  <main class="container mx-auto px-3 sm:px-4 py-4 sm:py-6">
    <!-- Hero Search Section -->
    <div class="glass rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-8 mb-6 sm:mb-8 bg-gradient-to-br from-uma-primary/10 to-uma-secondary/10">
      <div class="text-center mb-4 sm:mb-6">
        <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-display gradient-text mb-2 sm:mb-3 leading-tight">UmamusumeDB - Uma Musume Database</h1>
        <p class="text-sm sm:text-base md:text-lg text-gray-600 px-2">Welcome to UmamusumeDB, your ultimate resource for Uma Musume Pretty Derby game data, release dates, and training tools</p>
      </div>

      <!-- Main Search Bar -->
      <div class="max-w-3xl mx-auto">
        <div class="relative">
          <Search className="absolute left-3 sm:left-4 top-1/2 -translate-y-1/2 w-5 h-5 sm:w-6 sm:h-6 text-gray-400" />
          <input
            type="text"
            id="global-search"
            placeholder="Search UmamusumeDB for characters, cards, skills..."
            class="w-full pl-10 sm:pl-12 pr-3 sm:pr-4 py-3 sm:py-4 text-base sm:text-lg rounded-lg sm:rounded-xl border-2 border-uma-primary/20 bg-white/90 focus:outline-none focus:border-uma-primary shadow-lg"
          />
        </div>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-3 md:grid-cols-6 gap-3 sm:gap-4 mt-6 sm:mt-8">
        <div class="text-center">
          <div class="text-xl sm:text-2xl font-bold gradient-text">{characters.length}</div>
          <div class="text-xs sm:text-sm text-gray-600">Characters</div>
        </div>
        <div class="text-center">
          <div class="text-xl sm:text-2xl font-bold gradient-text">{supportCards.length}</div>
          <div class="text-xs sm:text-sm text-gray-600">Support Cards</div>
        </div>
        <div class="text-center">
          <div class="text-xl sm:text-2xl font-bold gradient-text">{supportCards.filter(c => c.rarity === 'SSR').length}</div>
          <div class="text-xs sm:text-sm text-gray-600">SSR Cards</div>
        </div>
        <div class="text-center">
          <div class="text-xl sm:text-2xl font-bold gradient-text">{skills.length}</div>
          <div class="text-xs sm:text-sm text-gray-600">Skills</div>
        </div>
        <div class="text-center">
          <div class="text-xl sm:text-2xl font-bold gradient-text">{scenariosData.length}</div>
          <div class="text-xs sm:text-sm text-gray-600">Scenarios</div>
        </div>
        <div class="text-center">
          <div class="text-xl sm:text-2xl font-bold gradient-text">{dataDate}</div>
          <div class="text-xs sm:text-sm text-gray-600">Data updated</div>
        </div>
      </div>
      <p class="text-center text-xs text-gray-500 mt-3">Covers the Global and JP servers; items not yet in Global are marked “JP only”. {globalCharacterCount} characters and {globalCardCount} support cards are available on Global.</p>
    </div>

    <!-- Quick Tools Section -->
    <div class="bg-gradient-to-r from-purple-50 to-blue-50 rounded-lg sm:rounded-xl p-4 sm:p-6 mb-6 sm:mb-8">
      <h2 class="text-lg sm:text-xl font-bold mb-3 sm:mb-4 flex items-center gap-2">
        <Calculator className="w-5 h-5 text-purple-600" />
        Training Tools
      </h2>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4">
        <a href="/tools/factor-calculator/" class="bg-white rounded-lg p-4 hover:shadow-lg transition-shadow border-2 border-yellow-200 hover:border-yellow-400">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 bg-yellow-100 rounded-lg flex items-center justify-center">
              <Star className="w-5 h-5 text-yellow-600" />
            </div>
            <div>
              <h3 class="font-semibold">Factor Calculator</h3>
              <p class="text-xs text-gray-600">Calculate inheritance rates</p>
            </div>
          </div>
          <div class="text-sm text-gray-700">
            Optimize your breeding strategy with precise factor inheritance probability calculations.
          </div>
        </a>
        
        <a href="/tools/training-calculator/" class="bg-white rounded-lg p-4 hover:shadow-lg transition-shadow border-2 border-purple-200 hover:border-purple-400">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
              <TrendingUp className="w-5 h-5 text-purple-600" />
            </div>
            <div>
              <h3 class="font-semibold">Training Calculator</h3>
              <p class="text-xs text-gray-600">Optimize stat gains</p>
            </div>
          </div>
          <div class="text-sm text-gray-700">
            Calculate optimal training paths and maximize your stat gains with support cards.
          </div>
        </a>
        
        <a href="/tools/support-deck/" class="bg-white rounded-lg p-4 hover:shadow-lg transition-shadow border-2 border-red-200 hover:border-red-400">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
              <Sparkles className="w-5 h-5 text-red-600" />
            </div>
            <div>
              <h3 class="font-semibold">Deck Builder</h3>
              <p class="text-xs text-gray-600">Build optimal decks</p>
            </div>
          </div>
          <div class="text-sm text-gray-700">
            Create the perfect 6-card support deck with synergy analysis and templates.
          </div>
        </a>
      </div>
      <div class="mt-4 text-center">
        <a href="/tools/" class="text-sm text-purple-600 hover:text-purple-700 font-medium">
          View All Tools →
        </a>
      </div>
    </div>

    <!-- Main Content Tabs -->
    <div class="flex gap-2 mb-4 sm:mb-6 overflow-x-auto pb-2 -mx-3 px-3 sm:mx-0 sm:px-0">
      <button class="tab-btn active" data-tab="characters">
        <Users className="w-4 h-4 mr-1 sm:mr-2" />
        <span class="text-sm sm:text-base">New Characters</span>
      </button>
      <button class="tab-btn" data-tab="support-cards">
        <Sparkles className="w-4 h-4 mr-1 sm:mr-2" />
        <span class="text-sm sm:text-base">New Cards</span>
      </button>
      <button class="tab-btn" data-tab="latest-releases">
        <Newspaper className="w-4 h-4 mr-1 sm:mr-2" />
        <span class="text-sm sm:text-base">Release Timeline</span>
      </button>
    </div>

    <!-- Characters Tab -->
    <div class="tab-content active" id="characters">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 sm:gap-4 mb-4">
        <h2 class="text-xl sm:text-2xl font-display">Newest Global Characters</h2>
        <a href="/characters/" class="text-sm text-uma-primary hover:underline">View all {characters.length} characters →</a>
      </div>
      <div id="characters-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 sm:gap-4">
        {newestCharacters.map((character) => (
          <div class="character-item">
            <CharacterCard character={character} client:visible />
          </div>
        ))}
      </div>
    </div>

    <!-- Support Cards Tab -->
    <div class="tab-content" id="support-cards">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 sm:gap-4 mb-4">
        <h2 class="text-xl sm:text-2xl font-display">Newest Global SSR Support Cards</h2>
        <a href="/cards/" class="text-sm text-uma-primary hover:underline">View all {supportCards.length} cards →</a>
      </div>
      <div id="cards-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 sm:gap-4">
        {newestCards.map((card) => (
          <div class="card-item">
            <SupportCardCard card={card} client:visible />
          </div>
        ))}
      </div>
    </div>

    <!-- Release Timeline Tab -->
    <div class="tab-content" id="latest-releases">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 sm:gap-4 mb-4">
        <h2 class="text-xl sm:text-2xl font-display">Latest Global Releases</h2>
        <span class="flex gap-4 text-sm"><a href="/global-release-schedule/" class="text-uma-primary hover:underline">Global release schedule →</a><a href="/updates/" class="text-uma-primary hover:underline">All updates →</a></span>
      </div>
      <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-2">
        {latestGlobal.map((e) => (
          <li>
            <a href={e.kind === 'character' ? `/characters/${e.id}/` : `/cards/${e.id}/`} class="block bg-white rounded-lg p-3 shadow hover:shadow-lg transition-shadow text-sm">
              <span class="font-medium">{e.name_en}</span>
              <span class="block text-xs text-gray-500">{e.date} · {e.kind === 'character' ? 'Character' : 'Support card'}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- SEO Content Section -->
    <section class="mt-8 sm:mt-12 glass rounded-lg sm:rounded-2xl p-4 sm:p-6 md:p-8 mb-6 sm:mb-8">
      <h2 class="text-xl sm:text-2xl font-display mb-3 sm:mb-4">About UmamusumeDB</h2>
      <div class="prose max-w-none text-gray-700">
        <p class="mb-3 sm:mb-4 text-sm sm:text-base">
          <strong>UmamusumeDB</strong> is your comprehensive online database for Uma Musume Pretty Derby.
          Our platform provides detailed information about all characters, support cards, and game mechanics
          to help trainers build the perfect team.
        </p>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6 mt-4 sm:mt-6">
          <div>
            <h3 class="font-bold text-lg mb-2">Why Choose UmamusumeDB?</h3>
            <ul class="text-sm space-y-1">
              <li>• Complete character database with stats</li>
              <li>• All SSR, SR, and R support cards</li>
              <li>• Global and JP release dates</li>
              <li>• Regular updates from UmamusumeDB team</li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold text-lg mb-2">UmamusumeDB Features</h3>
            <ul class="text-sm space-y-1">
              <li>• Advanced search and filtering</li>
              <li>• Latest announcements and release timeline</li>
              <li>• Training optimization tips</li>
              <li>• Skill inheritance calculator</li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold text-lg mb-2">Join UmamusumeDB Community</h3>
            <ul class="text-sm space-y-1">
              <li>• Global and JP release dates</li>
              <li>• Latest official announcements</li>
              <li>• Free training calculators</li>
              <li>• Get the latest game updates</li>
            </ul>
          </div>
        </div>
        <p class="mt-6 text-sm">
          Whether you're a new trainer or a veteran player, <strong>UmamusumeDB</strong> has all the resources 
          you need to excel in Uma Musume Pretty Derby. Browse our database, check the latest releases, 
          and optimize your teams with UmamusumeDB's comprehensive tools and guides.
        </p>
      </div>
    </section>

    <!-- Recommended External Tools -->
    <section class="mb-6 sm:mb-8">
      <h2 class="text-lg sm:text-xl font-bold mb-3 sm:mb-4 flex items-center gap-2">
        <Sparkles className="w-5 h-5 text-emerald-600" />
        Create Your Uma Musume Family Tree
      </h2>
      <a
        href="https://treecanvas.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="block bg-gradient-to-br from-emerald-50 via-teal-50 to-cyan-50 rounded-xl p-5 sm:p-6 hover:shadow-xl transition-all hover:scale-[1.01] border border-emerald-200 group"
      >
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <div class="w-14 h-14 bg-emerald-100 rounded-xl flex items-center justify-center group-hover:bg-emerald-200 transition-colors flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1">
              <h3 class="text-xl font-bold text-emerald-800">TreeCanvas</h3>
              <span class="text-xs text-emerald-600 bg-emerald-100 px-2 py-0.5 rounded">treecanvas.com</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400 group-hover:text-emerald-600 transition-colors">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </div>
            <p class="text-gray-700 text-sm sm:text-base mb-3">
              Create beautiful family trees for your <strong>Uma Musume OC (Original Characters)</strong>! 
              Design bloodline charts showing factor inheritance, parent lineages, and breeding strategies. 
              Perfect for visualizing your Uma Musume genealogy and sharing your OC creations with the community.
            </p>
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs bg-emerald-100 text-emerald-700 px-2 py-1 rounded-full">🆓 Free</span>
              <span class="text-xs bg-teal-100 text-teal-700 px-2 py-1 rounded-full">🎨 Create OC Family Trees</span>
              <span class="text-xs bg-cyan-100 text-cyan-700 px-2 py-1 rounded-full">📊 Factor Inheritance Visualization</span>
              <span class="text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded-full">💾 Export PNG/PDF</span>
            </div>
          </div>
        </div>
      </a>
    </section>
  </main>

  <style>
    .filter-btn {
      @apply px-3 sm:px-4 py-1.5 sm:py-2 rounded-full text-xs sm:text-sm font-medium transition-all;
      @apply bg-white/80 hover:bg-uma-primary/10 text-gray-700 whitespace-nowrap;
    }

    .filter-btn.active {
      @apply bg-gradient-to-r from-uma-primary to-uma-secondary text-white;
    }

    .tab-btn {
      @apply px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg font-medium transition-all flex items-center whitespace-nowrap flex-shrink-0;
      @apply bg-white hover:bg-uma-primary/10 text-gray-700;
    }

    .tab-btn.active {
      @apply bg-gradient-to-r from-uma-primary to-uma-secondary text-white;
    }

    .tier-filter-btn {
      @apply px-3 py-1.5 sm:py-1 rounded-lg text-xs sm:text-sm font-medium transition-all whitespace-nowrap flex-shrink-0;
      @apply bg-white hover:bg-uma-primary/10 text-gray-700;
    }

    .tier-filter-btn.active {
      @apply bg-uma-primary text-white;
    }

    .tab-content {
      @apply hidden;
    }

    .tab-content.active {
      @apply block;
    }

    /* Scrollbar styling for horizontal scroll */
    .overflow-x-auto::-webkit-scrollbar {
      height: 4px;
    }

    .overflow-x-auto::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.05);
      border-radius: 4px;
    }

    .overflow-x-auto::-webkit-scrollbar-thumb {
      background: rgba(255, 107, 157, 0.3);
      border-radius: 4px;
    }

    .overflow-x-auto::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 107, 157, 0.5);
    }

  </style>

  <script>
    // Tab switching
    const tabBtns = document.querySelectorAll('.tab-btn');
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tabId = btn.getAttribute('data-tab');
        tabBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('.tab-content').forEach((c) => c.classList.remove('active'));
        if (tabId) document.getElementById(tabId)?.classList.add('active');
      });
    });

    // The hero search box opens the site-wide search (searches every character, card and skill)
    const searchInput = document.getElementById('global-search') as HTMLInputElement | null;
    searchInput?.addEventListener('focus', () => {
      (document.getElementById('search-btn') as HTMLButtonElement | null)?.click();
      searchInput.blur();
    });
  </script>
</Layout>