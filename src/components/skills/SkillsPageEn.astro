---
import SkillCategoryLinks from '@/components/SkillCategoryLinks.astro';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { skills } from '@/lib/static-content';
import { Search, Filter, Zap, Timer, MapPin, Wind } from 'lucide-react';
import { buildSkillEntries } from '@/lib/skills-list-data';
import { renderSkillCard } from '@/lib/skill-list-render';
import { pageSlice, pagerHtml, totalPages, PAGE_SIZE } from '@/lib/pagination';

interface Props { page?: number }
const page = Astro.props.page ?? 1;
// Only one page of skills is in the HTML (crawlable via the pagination links); search/filters load the full list from /skills-data/en.json.
const entries = buildSkillEntries('en');
const pages = totalPages(entries.length);
const pageHtml = pageSlice(entries, page).map((e) => renderSkillCard('en', e, { prefix: '', jpLabel: 'JP only' })).join('');
const pager = pagerHtml('/skills/', page, pages, { aria: 'Skills pages', prev: 'Previous', next: 'Next', page: 'Page' });
const pageSuffix = page > 1 ? ` (Page ${page} of ${pages})` : '';

const rarities = [
  { value: 'normal', label: 'Normal (white)' },
  { value: 'gold', label: 'Gold (rare)' },
  { value: 'unique', label: 'Unique' },
  { value: 'evolved', label: 'Evolved' }
] as const;
const phases = [
  { value: 'all', label: 'All Phases' },
  { value: 'start', label: '🚀 Early-race' },
  { value: 'middle', label: '⚡ Mid-race' },
  { value: 'late', label: '🔥 Late-race' },
  { value: 'final', label: '🏁 Last spurt' },
  { value: 'corner', label: '🔄 Corner' },
  { value: 'straight', label: '📏 Straight' }
] as const;
const distances = [
  { value: 'all', label: 'All Distances' },
  { value: 'sprint', label: '⚡ Sprint' },
  { value: 'mile', label: '🏃 Mile' },
  { value: 'medium', label: '🏇 Medium' },
  { value: 'long', label: '🏔️ Long' }
] as const;
const styles = [
  { value: 'all', label: 'All Styles' },
  { value: 'escape', label: '💨 Escape (逃)' },
  { value: 'lead', label: '🏆 Lead (先)' },
  { value: 'between', label: '⚡ Between (差)' },
  { value: 'chase', label: '🎯 Chase (追)' }
] as const;
const effectTypes = [
  { value: 'all', label: 'All Effects' },
  { value: 'speed', label: '🚀 Speed' },
  { value: 'acceleration', label: '⚡ Acceleration' },
  { value: 'recovery', label: '💚 Recovery' },
  { value: 'positioning', label: '🎯 Position' },
  { value: 'stats', label: '📊 Stat boost' },
  { value: 'debuff', label: '🧊 Debuff' },
  { value: 'other', label: '🎲 Other' }
] as const;
---

<Layout
  title={`Skills${pageSuffix} - UmamusumeDB`}
  description={`Browse all Uma Musume Pretty Derby skills with advanced filtering. Filter by phase, distance, running style, effect type, and more.${page > 1 ? ` Page ${page} of ${pages}.` : ''}`}
>
  <Header />

  <main class="container mx-auto px-3 sm:px-4 py-4 sm:py-8">
    <Breadcrumb items={[{ label: 'Skills' }]} />

    <div class="mb-6 sm:mb-8">
      <h1 class="text-3xl sm:text-4xl font-display gradient-text mb-3 sm:mb-4">Skills Database</h1>
      <p class="text-sm sm:text-base text-gray-600">
        Browse {skills.length} skills with advanced filtering. Find the perfect skills for your training strategy.{page > 1 && ` Page ${page} of ${pages}.`}
      </p>
    </div>

    <SkillCategoryLinks locale="en" />

    <!-- Enhanced Filters -->
    <div class="glass rounded-xl p-4 mb-6">
      <!-- Search Row -->
      <div class="flex flex-col md:flex-row gap-4 mb-4">
        <div class="flex-1 relative">
          <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" />
          <input
            type="text"
            id="skill-search"
            placeholder="Search skill name, effect, or trigger..."
            class="w-full pl-10 pr-4 py-2 rounded-lg border border-uma-primary/20 bg-white/50 focus:outline-none focus:border-uma-primary"
          />
        </div>
        <button
          id="reset-filters"
          class="px-4 py-2 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 text-sm font-medium text-gray-600 transition"
        >
          Reset Filters
        </button>
      </div>

      <!-- Filter Rows -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
        <!-- Rarity Filter -->
        <div>
          <label class="text-xs font-medium text-gray-600 mb-1 block">Rarity</label>
          <select id="rarity-filter" class="w-full px-3 py-2 rounded-lg border border-uma-primary/20 bg-white/50 text-sm">
            <option value="all">All Rarities</option>
            {rarities.map((r) => (
              <option value={r.value}>{r.label}</option>
            ))}
          </select>
        </div>

        <!-- Type Filter -->
        <div>
          <label class="text-xs font-medium text-gray-600 mb-1 block">Skill Type</label>
          <select id="type-filter" class="w-full px-3 py-2 rounded-lg border border-uma-primary/20 bg-white/50 text-sm">
            <option value="all">All Types</option>
            <option value="unique">Unique</option>
            <option value="common">Common (normal / gold)</option>
            <option value="evolved">Evolved</option>
          </select>
        </div>

        <!-- Phase Filter -->
        <div>
          <label class="text-xs font-medium text-gray-600 mb-1 block">
            <Timer className="w-3 h-3 inline mr-1" />
            Phase
          </label>
          <select id="phase-filter" class="w-full px-3 py-2 rounded-lg border border-uma-primary/20 bg-white/50 text-sm">
            {phases.map((p) => (
              <option value={p.value}>{p.label}</option>
            ))}
          </select>
        </div>

        <!-- Distance Filter -->
        <div>
          <label class="text-xs font-medium text-gray-600 mb-1 block">
            <MapPin className="w-3 h-3 inline mr-1" />
            Distance
          </label>
          <select id="distance-filter" class="w-full px-3 py-2 rounded-lg border border-uma-primary/20 bg-white/50 text-sm">
            {distances.map((d) => (
              <option value={d.value}>{d.label}</option>
            ))}
          </select>
        </div>

        <!-- Style Filter -->
        <div>
          <label class="text-xs font-medium text-gray-600 mb-1 block">
            <Wind className="w-3 h-3 inline mr-1" />
            Running Style
          </label>
          <select id="style-filter" class="w-full px-3 py-2 rounded-lg border border-uma-primary/20 bg-white/50 text-sm">
            {styles.map((s) => (
              <option value={s.value}>{s.label}</option>
            ))}
          </select>
        </div>

        <!-- Effect Type Filter -->
        <div>
          <label class="text-xs font-medium text-gray-600 mb-1 block">
            <Zap className="w-3 h-3 inline mr-1" />
            Effect Type
          </label>
          <select id="effect-filter" class="w-full px-3 py-2 rounded-lg border border-uma-primary/20 bg-white/50 text-sm">
            {effectTypes.map((e) => (
              <option value={e.value}>{e.label}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Active Filter Tags -->
      <div id="active-filters" class="flex flex-wrap gap-2 mt-4 min-h-[28px]">
        <!-- Filter tags will be inserted here by JS -->
      </div>
    </div>

    <!-- Results Count -->
    <div class="flex items-center justify-between mb-4">
      <div class="text-sm text-gray-600">
        Showing <span id="result-count" class="font-semibold text-uma-primary">{skills.length}</span> skills
      </div>
      <div class="text-xs text-gray-500">
        Filter by race phase, distance, and style to find optimal skills
      </div>
    </div>

    <!-- Skills Grid -->
    <div
      id="skills-container"
      class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-6"
      data-skills-json="/skills-data/en.json" data-kind="en" data-prefix="" data-jp-label="JP only" data-more-label="Show more" data-step={PAGE_SIZE}
      set:html={pageHtml}
    ></div>
    <Fragment set:html={pager} />

    <div id="no-results" class="hidden text-center py-12">
      <Filter className="w-16 h-16 text-gray-300 mx-auto mb-4" />
      <p class="text-xl text-gray-500 mb-2">No skills found matching your filters</p>
      <p class="text-sm text-gray-400">Try adjusting your search or filter criteria</p>
      <button
        id="clear-all-filters"
        class="mt-4 px-4 py-2 bg-uma-primary text-white rounded-lg hover:bg-uma-primary/90 transition"
      >
        Clear All Filters
      </button>
    </div>

    <!-- Usage Guide -->
    <div class="mt-8 glass rounded-xl p-6">
      <h2 class="text-lg font-semibold mb-4">Skill Filter Guide</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 text-sm text-gray-700">
        <div>
          <div class="font-medium text-uma-primary mb-2 flex items-center gap-2">
            <Timer className="w-4 h-4" />
            Race Phase
          </div>
          <ul class="space-y-1 text-xs text-gray-600">
            <li><strong>Early-race:</strong> first sixth of the race</li>
            <li><strong>Mid-race:</strong> up to two-thirds of the race</li>
            <li><strong>Late-race:</strong> up to the last spurt</li>
            <li><strong>Last spurt:</strong> final straight and closing phase</li>
            <li><strong>Corner/Straight:</strong> skills tied to a corner or straight</li>
          </ul>
        </div>
        <div>
          <div class="font-medium text-uma-primary mb-2 flex items-center gap-2">
            <MapPin className="w-4 h-4" />
            Distance
          </div>
          <ul class="space-y-1 text-xs text-gray-600">
            <li><strong>Sprint:</strong> Short races (1000-1600m)</li>
            <li><strong>Mile:</strong> Medium-short (1600-2000m)</li>
            <li><strong>Medium:</strong> Classic distances (2000-2400m)</li>
            <li><strong>Long:</strong> Stamina-intensive (2500m+)</li>
          </ul>
        </div>
        <div>
          <div class="font-medium text-uma-primary mb-2 flex items-center gap-2">
            <Wind className="w-4 h-4" />
            Running Style
          </div>
          <ul class="space-y-1 text-xs text-gray-600">
            <li><strong>Escape:</strong> Front runner (逃げ)</li>
            <li><strong>Lead:</strong> Pace chaser (先行)</li>
            <li><strong>Between:</strong> Mid-pack surger (差し)</li>
            <li><strong>Chase:</strong> Late closer (追込)</li>
          </ul>
        </div>
        <div>
          <div class="font-medium text-uma-primary mb-2 flex items-center gap-2">
            <Zap className="w-4 h-4" />
            Effect Type
          </div>
          <ul class="space-y-1 text-xs text-gray-600">
            <li><strong>Speed:</strong> Velocity increase</li>
            <li><strong>Acceleration:</strong> Speed build-up</li>
            <li><strong>Recovery:</strong> Stamina recovery</li>
            <li><strong>Stat boost:</strong> Raises a stat for the race</li>
          </ul>
        </div>
      </div>
    </div>
  </main>

  <script>
    import '@/lib/skills-list-client';
  </script>
</Layout>
