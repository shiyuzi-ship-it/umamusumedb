---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import type { Locale } from '@/lib/i18n';
import { categories } from '@/lib/skill-categories';
import { cs, categoryAdj } from '@/lib/skill-category-strings';
import { t } from '@/lib/ui-strings';
import { path } from '@/lib/page-helpers';
interface Props { locale: Locale }
const { locale: loc } = Astro.props;
const groups = (['global', 'evolved'] as const).map((scope) => ({
  scope,
  title: cs(loc, scope === 'global' ? 'hubGlobal' : 'hubEvolved'),
  list: categories.filter((c) => c.scope === scope && c.locales.includes(loc)),
})).filter((g) => g.list.length > 0);
const title = cs(loc, 'hubTitle'), description = cs(loc, 'hubDescription');
const itemList = groups.flatMap((g) => g.list).map((c) => ({ name: categoryAdj(loc, c), url: path(`/skills/category/${c.slug}/`, loc) }));
---
<Layout title={title} description={description} structuredDataType="webpage" structuredData={{ name: cs(loc, 'hubH1'), title, description, about: 'Uma Musume skill categories' }} itemList={itemList}>
  <Header />
  <main class="container mx-auto px-3 sm:px-4 py-4 sm:py-8">
    <Breadcrumb items={[{ label: t(loc, 'navSkills'), href: path('/skills/', loc) }, { label: cs(loc, 'navSkillGroups') }]} />
    <h1 class="text-3xl sm:text-4xl font-display gradient-text mb-3">{cs(loc, 'hubH1')}</h1>
    <p class="text-gray-600 max-w-3xl mb-8">{cs(loc, 'hubIntro')}</p>
    {groups.map((g) => (
      <section class="mb-8">
        <h2 class="text-2xl font-display mb-3">{g.title}</h2>
        <ul class="flex flex-wrap gap-2">
          {g.list.map((c) => (
            <li><a href={path(`/skills/category/${c.slug}/`, loc)} class="inline-block px-3 py-1.5 rounded-full bg-white shadow-sm text-sm text-uma-primary hover:shadow">{categoryAdj(loc, c)} <span class="text-gray-400">({c.ids[loc]?.length})</span></a></li>
          ))}
        </ul>
      </section>
    ))}
    <a class="text-sm text-uma-primary hover:underline" href={path('/skills/', loc)}>{cs(loc, 'allSkills')}</a>
  </main>
</Layout>
