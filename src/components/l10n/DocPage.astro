---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import type { Locale } from '@/lib/i18n';
import { getDoc, type DocKind } from '@/lib/legal';

interface Props { locale: Locale; kind: DocKind }
const { locale, kind } = Astro.props;
const doc = getDoc(kind, locale);
const ICON: Record<string, string> = {
  rocket: 'M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09zM12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z',
  layers: 'M12 2 2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5',
  sparkles: 'M12 3l1.9 5.8L20 10l-6.1 1.2L12 17l-1.9-5.8L4 10l6.1-1.2L12 3z',
  target: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12zM12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
  database: 'M12 8c4.97 0 9-1.34 9-3s-4.03-3-9-3-9 1.34-9 3 4.03 3 9 3zM3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3',
  shield: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9 12l2 2 4-4',
  scale: 'M12 3v18M5 7l-3 7a4 4 0 0 0 6 0L5 7zM19 7l-3 7a4 4 0 0 0 6 0l-3-7zM3 7h18',
};
const COLOR: Record<string, string> = { rocket: 'text-uma-primary', layers: 'text-uma-secondary', sparkles: 'text-uma-accent', target: 'text-green-600', database: 'text-uma-primary', shield: 'text-green-600', scale: 'text-uma-accent' };
const Icon = (k?: string) => k && ICON[k] ? ICON[k] : '';
---
<Layout title={doc.title} description={doc.description}>
  <Header />
  {(kind === 'privacy' || kind === 'terms') && (
    <main class="container mx-auto px-4 py-8 max-w-4xl">
      <div class="glass rounded-2xl p-8">
        <h1 class="text-4xl font-display gradient-text mb-6">{doc.h1}</h1>
        <p class="text-gray-600 mb-8">{doc.updated}</p>
        <div class="prose prose-lg max-w-none">
          {doc.sections.map((s) => (
            <section class="mb-8">
              <h2 class="text-2xl font-bold mb-4">{s.h}</h2>
              {s.blocks.map((b: any) =>
                b.p ? <p class="text-gray-700 mb-4" set:html={b.p} />
                : b.h3 ? <h3 class="text-xl font-semibold mb-3">{b.h3}</h3>
                : b.ul ? <ul class="list-disc pl-6 mb-4 text-gray-700 space-y-2">{b.ul.map((li: string) => <li set:html={li} />)}</ul>
                : <div class="bg-gray-50 rounded-lg p-4 mt-4"><p class="text-gray-700" set:html={b.box} /></div>
              )}
            </section>
          ))}
        </div>
      </div>
    </main>
  )}
  {kind === 'guides' && (
    <main class="container mx-auto px-3 sm:px-4 py-4 sm:py-8">
      <Breadcrumb items={[{ label: doc.h1 }]} />
      <div class="mb-6 sm:mb-8">
        <h1 class="text-3xl sm:text-4xl font-display gradient-text mb-3 sm:mb-4">{doc.h1}</h1>
        <p class="text-sm sm:text-base text-gray-600" set:html={doc.intro} />
      </div>
      <div class="grid md:grid-cols-2 gap-4 sm:gap-6">
        {doc.cards?.map((c) => (
          <a href={`#${c.id}`} class="glass rounded-xl p-5 hover:shadow-lg transition-shadow">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-lg bg-uma-primary/10 flex items-center justify-center shrink-0">
                <svg class={`w-5 h-5 ${COLOR[c.icon]}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={Icon(c.icon)} /></svg>
              </div>
              <div class="flex-1"><h2 class="font-bold text-lg mb-1">{c.title}</h2><p class="text-sm text-gray-600">{c.desc}</p></div>
            </div>
          </a>
        ))}
      </div>
      {doc.sections.map((s) => (
        <section id={s.id} class="mt-10 scroll-mt-24">
          <h2 class="text-2xl font-bold mb-3 flex items-center gap-2">
            <svg class={`w-5 h-5 ${COLOR[s.icon ?? '']}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={Icon(s.icon)} /></svg>{s.h}
          </h2>
          <div class="glass rounded-xl p-5 prose max-w-none">
            {s.blocks.map((b: any) => b.p ? <p set:html={b.p} /> : b.ul ? <ul class="list-disc list-inside space-y-2">{b.ul.map((li: string) => <li set:html={li} />)}</ul> : null)}
          </div>
        </section>
      ))}
    </main>
  )}
  {kind === 'sources' && (
    <main class="container mx-auto px-3 sm:px-4 py-4 sm:py-8 max-w-4xl">
      <Breadcrumb items={[{ label: doc.h1 }]} />
      <div class="glass rounded-2xl p-6 sm:p-8">
        <h1 class="text-2xl sm:text-4xl font-display gradient-text mb-4">{doc.h1}</h1>
        <p class="text-sm sm:text-base text-gray-600">{doc.intro}</p>
        <div class="mt-8 space-y-6">
          {doc.sections.map((s) => (
            <section class="bg-white rounded-xl p-5 border border-uma-primary/10">
              <h2 class="text-lg font-bold flex items-center gap-2">
                <svg class={`w-5 h-5 ${COLOR[s.icon ?? '']}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={Icon(s.icon)} /></svg>{s.h}
              </h2>
              {s.blocks.map((b: any) => b.p ? <p class="text-sm text-gray-700 mt-2 [&_a]:text-uma-primary [&_a:hover]:underline" set:html={b.p} /> : b.ul ? <ul class="mt-2 list-disc pl-5 text-sm text-gray-700 space-y-1 [&_a]:text-uma-primary">{b.ul.map((li: string) => <li set:html={li} />)}</ul> : null)}
            </section>
          ))}
        </div>
      </div>
    </main>
  )}
</Layout>
<style is:global>
  .prose a { color: rgb(var(--uma-primary)); }
  .prose a:hover { text-decoration: underline; }
  .prose strong { color: rgb(var(--uma-dark)); }
</style>
