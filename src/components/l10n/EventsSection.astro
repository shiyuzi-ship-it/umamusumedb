---
import type { Locale } from '@/lib/i18n';
import { t } from '@/lib/ui-strings';
import { rewardGroups, orLabel, eventName, eventAltName, eventType, choiceLabel, type Ev } from '@/lib/events';
import { skillClass } from '@/lib/skill-class';
import { localizePathname } from '@/lib/i18n';

interface Props { locale: Locale; blocks: { heading: string; events: Ev[] }[]; charId?: number }
const { locale: loc, blocks, charId } = Astro.props;
const shown = blocks.filter((b) => b.events.length);
const total = shown.reduce((a, b) => a + b.events.length, 0);
const hrefFor = (id: string) => (skillClass.get(id) === 'all' || (skillClass.get(id) === 'jp' && loc === 'ja') ? localizePathname(`/skills/${id}/`, loc) : '');
---
{total > 0 && (
  <section class="glass rounded-xl p-6" id="events">
    <h2 class="text-xl font-display mb-1">{t(loc, 'eventsTitle')} <span class="text-sm text-gray-500 font-normal">({t(loc, 'eventsCount', { n: total })})</span></h2>
    <p class="text-xs text-gray-500 mb-4">{t(loc, 'eventsNote')}</p>
    {shown.map((b) => (
      <div class="mb-6 last:mb-0">
        <h3 class="font-semibold text-sm mb-2">{b.heading} <span class="text-gray-400 font-normal">· {b.events.length}</span></h3>
        <ul class="grid md:grid-cols-2 gap-3">
          {b.events.map((e) => (
            <li class="bg-white rounded-lg p-3 text-sm">
              <div class="font-medium">{eventName(e, loc)}</div>
              {eventAltName(e, loc) && eventAltName(e, loc) !== eventName(e, loc) && <div class="text-xs text-gray-400">{eventAltName(e, loc)}</div>}
              {eventType(e, loc) && <div class="text-xs text-gray-500 mt-1">{eventType(e, loc)}</div>}
              <div class="mt-2 space-y-2">
                {e.c.map((ch, i) => {
                  const groups = rewardGroups(ch, loc, hrefFor, charId);
                  return (
                    <div>
                      {choiceLabel(e, i, loc) && <div class="text-xs font-semibold text-gray-600">{choiceLabel(e, i, loc)}</div>}
                      {groups.map((g, gi) => (
                        <div class="text-xs text-gray-700">
                          {gi > 0 && <span class="text-gray-400 mr-1">{orLabel(loc)}</span>}
                          {g.map((it, k) => (<>{k > 0 && <span class="text-gray-300"> · </span>}{it.href ? <a href={it.href} class="text-uma-primary hover:underline">{it.text}</a> : <span>{it.text}</span>}</>))}
                        </div>
                      ))}
                    </div>
                  );
                })}
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
)}
