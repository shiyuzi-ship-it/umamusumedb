---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import type { Locale } from '@/lib/i18n';
import { holoIntroHref, holoRitualHref, HOLO_ROSTER_COUNT } from '@/lib/holo';
import { holoStrings } from '@/lib/holo-strings';

interface Props { locale: Locale }
const { locale } = Astro.props;
const s = holoStrings(locale);
const introHref = holoIntroHref(locale);
const ritualHref = holoRitualHref(locale);
const pageUrl = 'https://umamusumedb.com' + introHref;
---
<Layout
  title={s.introTitle}
  description={s.introDesc}
  image="https://umamusumedb.com/holo/og/pack.webp"
  largeOg={true}
  structuredDataType="tool"
  structuredData={{ name: s.introTitle, description: s.introDesc, url: pageUrl }}
>
  <Header />
  <main class="container mx-auto px-3 sm:px-4 py-4 sm:py-8 max-w-3xl">
    <Breadcrumb items={[{ label: s.toolsCrumb, href: (locale === 'en' ? '' : `/${locale}`) + '/tools/' }, { label: s.introH1 }]} />
    <div class="holo-intro-hero">
      <img class="holo-intro-pack" src="/holo/og/pack.webp" alt={s.introH1} width="400" height="210" />
      <div>
        <h1 class="text-3xl font-display gradient-text mb-3">{s.introH1}</h1>
        <p class="text-gray-700 mb-6 leading-relaxed">{s.introDesc}</p>
        <p class="mb-2">
          <a href={ritualHref} class="holo-intro-cta">{s.homeCta}</a>
        </p>
      </div>
    </div>
    <div class="holo-intro-panel text-gray-700 leading-relaxed">
      <h2>{s.howTitle}</h2>
      <ul>
        {s.howItems.map((item) => (
          <li set:html={item.replace(/UMA-[^。．.！!]*XXXX/, '<code>UMA-YYYYMMDD-XXXX</code>')} />
        ))}
      </ul>
      <h2>{s.poolTitle}</h2>
      <p>{s.poolBody.replace('274', String(HOLO_ROSTER_COUNT))}</p>
      <h2>{s.aboutTitle}</h2>
      <p>{s.aboutBody}</p>
    </div>
  </main>
</Layout>
<style is:global>
  @import url('/holo/pack-assets/pack-v5.css');
</style>
