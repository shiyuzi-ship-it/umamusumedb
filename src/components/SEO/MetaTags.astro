---
import { LOCALE_META, type Locale } from '@/lib/i18n';

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL: string;
  type?: 'website' | 'article';
  locale?: Locale;
  /** Absolute URLs of every real translation of this page (including the page itself). Empty/single => no hreflang block. */
  alternates?: Partial<Record<Locale, string>>;
  noindex?: boolean;
}

const {
  title,
  description,
  image = 'https://umamusumedb.com/og-image.png',
  canonicalURL,
  type = 'website',
  locale = 'en',
  alternates = {},
  noindex = false,
} = Astro.props;

const fullTitle = title.includes('UmamusumeDB') ? title : `${title} | UmamusumeDB`;
const isDefaultOg = image.endsWith('og-image.png');
const altEntries = (Object.entries(alternates) as [Locale, string][]).filter(([, url]) => !!url);
// hreflang only on indexable pages that actually have at least one other-language page
const showHreflang = !noindex && altEntries.length > 1;
const ogAlternates = altEntries.filter(([l]) => l !== locale).map(([l]) => LOCALE_META[l].og);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<link rel="canonical" href={canonicalURL} />

{showHreflang && altEntries.map(([l, url]) => <link rel="alternate" hreflang={LOCALE_META[l].hreflang} href={url} />)}
{showHreflang && alternates.en && <link rel="alternate" hreflang="x-default" href={alternates.en} />}

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
{isDefaultOg && <meta property="og:image:width" content="1200" />}
{isDefaultOg && <meta property="og:image:height" content="630" />}
<meta property="og:site_name" content="UmamusumeDB" />
<meta property="og:locale" content={LOCALE_META[locale].og} />
{showHreflang && ogAlternates.map((alt) => <meta property="og:locale:alternate" content={alt} />)}

<meta name="twitter:card" content={isDefaultOg ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:site" content="@umamusumedb" />

<meta name="author" content="UmamusumeDB" />
<meta name="application-name" content="UmamusumeDB" />
<meta name="apple-mobile-web-app-title" content="UmamusumeDB" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="theme-color" content="#FF6B9D" />
