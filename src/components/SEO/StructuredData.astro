---
import { LOCALE_META, type Locale } from '@/lib/i18n';

export interface Props {
  type?: 'website' | 'character' | 'supportCard' | 'skill' | 'tool' | 'webpage';
  /** name / description / image_url / url (+ legacy name_en, name_ja) */
  data?: any;
  pageUrl?: string;
  locale?: Locale;
  /** Optional ItemList for list pages */
  itemList?: { name: string; url: string; image?: string }[];
}

const { type = 'website', data, pageUrl = Astro.url.href, locale = 'en', itemList } = Astro.props;
const siteUrl = 'https://umamusumedb.com';
const inLanguage = LOCALE_META[locale].htmlLang;
const abs = (u?: string) => (u ? (u.startsWith('/') ? siteUrl + u : u) : undefined);
const name = data?.name ?? data?.name_en;

const schemas: any[] = [];

// Site-wide entities on the home page of each locale (kept off other pages: one WebSite/Organization is enough)
if (type === 'website' && !data && new URL(pageUrl).pathname === (locale === 'en' ? '/' : `/${locale}/`)) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    name: 'UmamusumeDB',
    alternateName: ['Uma Musume Pretty Derby Database', 'ウマ娘 データベース'],
    url: siteUrl + '/',
    inLanguage: ['en', 'ja', 'zh-Hans', 'zh-Hant', 'ko'],
    publisher: { '@type': 'Organization', name: 'UmamusumeDB', url: siteUrl + '/', logo: { '@type': 'ImageObject', url: `${siteUrl}/logo.svg` } },
  });
}

if ((type === 'character' || type === 'supportCard' || type === 'skill') && name) {
  // A game character / card has no dedicated schema.org type: describe the page and what it is about.
  const description = data.description;
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: data.title ?? name,
    url: pageUrl,
    inLanguage,
    isPartOf: { '@id': `${siteUrl}/#website` },
    ...(abs(data.image_url) ? { primaryImageOfPage: { '@type': 'ImageObject', url: abs(data.image_url) } } : {}),
    about: {
      '@type': 'Thing',
      name,
      ...((data.name_ja || data.alternateName) ? { alternateName: data.alternateName ?? data.name_ja } : {}),
      ...(description ? { description } : {}),
      ...(abs(data.image_url) ? { image: abs(data.image_url) } : {}),
    },
  });
}

if (type === 'webpage' && name) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: data.title ?? name,
    description: data.description,
    url: abs(data.url) ?? pageUrl,
    inLanguage,
    ...(data.dateModified ? { dateModified: data.dateModified } : {}),
    isPartOf: { '@id': `${siteUrl}/#website` },
    ...(data.about ? { about: { '@type': 'Thing', name: data.about } } : {}),
  });
}

if (type === 'tool' && name) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name,
    description: data.description,
    url: abs(data.url) ?? pageUrl,
    inLanguage,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any (web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    isPartOf: { '@id': `${siteUrl}/#website` },
  });
}

if (itemList?.length) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    numberOfItems: itemList.length,
    itemListElement: itemList.slice(0, 50).map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: abs(it.url),
      name: it.name,
      ...(abs(it.image) ? { image: abs(it.image) } : {}),
    })),
  });
}
---

{schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
