---
import { Search, Menu, X, Github, Globe } from 'lucide-react';
import {
  LOCALE_META, SUPPORTED_LOCALES, availableLocalesFor, getLocaleFromPathname, hrefFor, localizePathname,
  stripLocaleFromPathname, type Locale,
} from '@/lib/i18n';
import { seoOpts } from '@/lib/skill-class';
import { t } from '@/lib/ui-strings';

const pathname = Astro.url.pathname;
const locale: Locale = getLocaleFromPathname(pathname);
const basePath = stripLocaleFromPathname(pathname);
const avail = new Set<Locale>([...availableLocalesFor(basePath, seoOpts), locale]);
const switcher = SUPPORTED_LOCALES.filter((l) => avail.has(l)).map((l) => ({
  locale: l,
  href: localizePathname(basePath, l),
  native: LOCALE_META[l].native,
  hreflang: LOCALE_META[l].htmlLang,
}));

const nav = [
  { href: hrefFor('/tools/', locale), label: t(locale, 'navTools') },
  { href: hrefFor('/characters/', locale), label: t(locale, 'navCharacters') },
  { href: hrefFor('/cards/', locale), label: t(locale, 'navCards') },
  { href: hrefFor('/skills/', locale), label: t(locale, 'navSkills') },
  { href: hrefFor('/updates/', locale), label: t(locale, 'navUpdates') },
  { href: hrefFor('/guides/', locale), label: t(locale, 'navGuides') },
];
const hrefHome = localizePathname('/', locale);
const searchStrings = {
  start: t(locale, 'searchStart'), none: t(locale, 'searchNone'), offline: t(locale, 'searchOffline'),
  character: t(locale, 'kindCharacter'), card: t(locale, 'kindSupport'), skill: t(locale, 'navSkills'),
};
---

<header class="sticky top-0 z-50 glass">
  <nav class="container mx-auto px-3 sm:px-4 py-3 sm:py-4">
    <div class="flex items-center justify-between gap-2">
      <a href={hrefHome} class="flex items-center space-x-2 sm:space-x-3 group flex-shrink-0">
        <img src="/logo.svg" alt="UmamusumeDB" width="40" height="40" class="w-8 h-8 sm:w-10 sm:h-10" />
        <span class="font-display text-lg sm:text-2xl gradient-text hidden xs:inline">UmamusumeDB</span>
      </a>

      <div class="hidden lg:flex items-center space-x-6">
        {nav.map((n) => (
          <a href={n.href} class="font-medium hover:text-uma-primary transition-colors whitespace-nowrap">{n.label}</a>
        ))}
      </div>

      <div class="flex items-center gap-2 sm:gap-3">
        <button id="search-btn" class="p-2 hover:bg-uma-primary/10 rounded-lg transition-colors flex-shrink-0" aria-label={t(locale, 'searchLabel')}>
          <Search class="w-4 h-4 sm:w-5 sm:h-5" />
        </button>

        <a href="https://github.com/shiyuzi-ship-it/umamusumedb" target="_blank" rel="noopener noreferrer"
           class="hidden lg:flex items-center gap-1 px-3 py-1.5 rounded-lg border border-uma-primary/20 bg-white/50 text-sm hover:bg-uma-primary/10 transition-colors whitespace-nowrap">
          <Github class="w-4 h-4" />
          <span>GitHub</span>
        </a>

        <!-- Language switcher (only locales that have this page) -->
        <details class="relative lang-switcher">
          <summary class="list-none cursor-pointer flex items-center gap-1 px-3 py-1.5 rounded-lg border border-uma-primary/20 bg-white/50 text-sm hover:bg-uma-primary/10 whitespace-nowrap" aria-label={t(locale, 'language')}>
            <Globe class="w-4 h-4" />
            <span>{LOCALE_META[locale].native}</span>
          </summary>
          <ul class="absolute right-0 mt-2 w-40 rounded-lg border border-uma-primary/20 bg-white shadow-lg py-1 z-50">
            {switcher.map((o) => (
              <li>
                <a
                  href={o.href}
                  hreflang={o.hreflang}
                  lang={o.hreflang}
                  class={`block px-3 py-2 text-sm hover:bg-uma-primary/10 ${o.locale === locale ? 'font-bold text-uma-primary' : ''}`}
                >{o.native}</a>
              </li>
            ))}
          </ul>
        </details>

        <button id="mobile-menu-btn" class="lg:hidden p-2 hover:bg-uma-primary/10 rounded-lg transition-colors flex-shrink-0" aria-label="Menu">
          <Menu id="menu-icon" class="w-5 h-5" />
          <X id="close-icon" class="w-5 h-5 hidden" />
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden mt-4 pt-4 border-t border-uma-primary/20">
      <div class="flex flex-col space-y-3">
        {nav.map((n) => (
          <a href={n.href} class="font-medium hover:text-uma-primary transition-colors py-2 px-2 rounded-lg hover:bg-uma-primary/5">{n.label}</a>
        ))}
      </div>
    </div>

    <!-- Search modal -->
    <div id="search-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden">
      <div class="container mx-auto px-4 py-8 sm:py-16">
        <div class="max-w-3xl mx-auto">
          <div class="glass rounded-2xl p-4 sm:p-6 mb-4">
            <div class="relative">
              <Search class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" />
              <input
                type="search"
                id="global-search-input"
                placeholder={t(locale, 'searchPlaceholder')}
                autocomplete="off"
                class="w-full pl-12 pr-12 py-3 sm:py-4 text-base sm:text-lg rounded-xl border-2 border-uma-primary/20 bg-white/90 focus:outline-none focus:border-uma-primary"
              />
              <button id="close-search" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600" aria-label="Close">
                <X class="w-5 h-5" />
              </button>
            </div>
            <div class="text-xs sm:text-sm text-gray-500 mt-2 px-1"><kbd class="px-2 py-1 bg-gray-100 rounded text-xs mx-1">ESC</kbd> {t(locale, 'searchHint')}</div>
          </div>
          <div id="search-results" class="glass rounded-2xl p-4 sm:p-6 max-h-[60vh] overflow-y-auto">
            <div id="search-empty" class="text-center py-8 text-gray-500">{t(locale, 'searchStart')}</div>
            <div id="search-content" class="hidden space-y-3"></div>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  .lang-switcher summary::-webkit-details-marker { display: none; }
  @media (min-width: 375px) {
    .xs\:inline { display: inline; }
  }
</style>

<script define:vars={{ locale, searchStrings }}>
  const $ = (id) => document.getElementById(id);
  const mobileBtn = $('mobile-menu-btn'), mobileMenu = $('mobile-menu'), menuIcon = $('menu-icon'), closeIcon = $('close-icon');
  mobileBtn?.addEventListener('click', () => {
    const hidden = mobileMenu.classList.toggle('hidden');
    menuIcon.classList.toggle('hidden', !hidden);
    closeIcon.classList.toggle('hidden', hidden);
  });

  // Close the language menu when clicking elsewhere
  document.addEventListener('click', (e) => {
    document.querySelectorAll('.lang-switcher[open]').forEach((d) => { if (!d.contains(e.target)) d.removeAttribute('open'); });
  });

  const modal = $('search-modal'), input = $('global-search-input'), empty = $('search-empty'), content = $('search-content');
  const prefix = locale === 'en' ? '' : '/' + locale;
  const ICON = { c: '👤', k: '🎴', s: '✨', p: '📑', t: '🛠️' };
  const PATH = { c: 'characters', k: 'cards', s: 'skills' };
  let data = null, loading = null;

  // Normalise for matching: lowercase, katakana -> hiragana, drop spaces / punctuation / brackets
  const norm = (s) => String(s || '').toLowerCase()
    .replace(/[\u30a1-\u30f6]/g, (ch) => String.fromCharCode(ch.charCodeAt(0) - 0x60))
    .replace(/[\s\-_・·.,'’"“”()（）\[\]【】「」:：!！?？~〜☆★♪]/g, '');

  const load = () => {
    if (data) return Promise.resolve(data);
    if (!loading) {
      loading = fetch('/search/' + locale + '.json')
        .then((r) => { if (!r.ok) throw new Error(r.status); return r.json(); })
        .then((j) => { data = j.items; for (const it of data) it._q = norm(it.q); return data; })
        .catch(() => { data = []; empty.textContent = searchStrings.offline; return data; });
    }
    return loading;
  };

  const openSearch = () => { modal.classList.remove('hidden'); setTimeout(() => input.focus(), 50); load(); };
  const closeSearch = () => { modal.classList.add('hidden'); input.value = ''; empty.textContent = searchStrings.start; empty.classList.remove('hidden'); content.classList.add('hidden'); };
  $('search-btn')?.addEventListener('click', openSearch);
  $('close-search')?.addEventListener('click', closeSearch);
  modal?.addEventListener('click', (e) => { if (e.target === modal) closeSearch(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeSearch();
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); openSearch(); }
  });

  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const urlOf = (it) => it.u ? it.u : prefix + '/' + PATH[it.t] + '/' + it.id + '/';

  input?.addEventListener('input', async () => {
    const q = norm(input.value);
    if (!q) { empty.textContent = searchStrings.start; empty.classList.remove('hidden'); content.classList.add('hidden'); return; }
    const items = await load();
    const scored = [];
    for (const it of items) {
      const n = norm(it.n);
      let score = 0;
      if (n === q) score = 100;
      else if (n.startsWith(q)) score = 80;
      else if (n.includes(q)) score = 60;
      else if (it._q.includes(q)) score = 40;
      if (score) scored.push([score + (it.t === 'p' ? 5 : it.t === 'c' ? 3 : 0), it]);
    }
    scored.sort((a, b) => b[0] - a[0]);
    const results = scored.slice(0, 12).map((x) => x[1]);
    if (!results.length) { empty.textContent = searchStrings.none; empty.classList.remove('hidden'); content.classList.add('hidden'); return; }
    empty.classList.add('hidden'); content.classList.remove('hidden');
    content.innerHTML = results.map((it) => `
      <a href="${urlOf(it)}" class="block p-3 bg-white rounded-lg hover:shadow-lg transition-shadow">
        <div class="flex items-center gap-3">
          ${it.im ? `<img src="${esc(it.im)}" alt="" width="40" height="40" loading="lazy" class="w-10 h-10 rounded object-contain bg-gray-50 flex-shrink-0">` : `<div class="w-10 h-10 rounded bg-gray-100 flex items-center justify-center text-xl flex-shrink-0">${ICON[it.t] || '📄'}</div>`}
          <div class="flex-1 min-w-0">
            <div class="font-semibold text-gray-900 truncate">${esc(it.n)}</div>
            ${it.s ? `<div class="text-sm text-gray-500 truncate">${esc(it.s)}</div>` : ''}
          </div>
          <div class="text-xs text-gray-400 px-2 py-1 bg-gray-50 rounded flex-shrink-0">${esc(searchStrings[{ c: 'character', k: 'card', s: 'skill' }[it.t]] || '')}</div>
        </div>
      </a>`).join('');
  });
</script>
