---
import { getLocaleFromPathname, hrefFor, localizePathname, type Locale } from '@/lib/i18n';
import { t } from '@/lib/ui-strings';

const locale: Locale = getLocaleFromPathname(Astro.url.pathname);
const L = (path: string) => hrefFor(path, locale);
---

<footer class="mt-16 border-t border-gray-200 bg-white/50 backdrop-blur-sm">
  <div class="container mx-auto px-4 py-8">
    <div class="grid md:grid-cols-4 gap-8 mb-8">
      <div>
        <h3 class="font-bold text-lg mb-3 gradient-text">UmamusumeDB</h3>
        <p class="text-sm text-gray-600">{t(locale, 'footerTagline')}</p>
      </div>

      <div>
        <h3 class="font-bold text-sm mb-3 text-gray-800">{t(locale, 'footerLinks')}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={localizePathname('/', locale)} class="text-gray-600 hover:text-uma-primary transition-colors">{t(locale, 'home')}</a></li>
          <li><a href={L('/characters/')} class="text-gray-600 hover:text-uma-primary transition-colors">{t(locale, 'navCharacters')}</a></li>
          <li><a href={L('/cards/')} class="text-gray-600 hover:text-uma-primary transition-colors">{t(locale, 'navCards')}</a></li>
          <li><a href={L('/skills/')} class="text-gray-600 hover:text-uma-primary transition-colors">{t(locale, 'navSkills')}</a></li>
          <li><a href={L('/updates/')} class="text-gray-600 hover:text-uma-primary transition-colors">{t(locale, 'navUpdates')}</a></li>
          <li><a href={L('/tools/')} class="text-gray-600 hover:text-uma-primary transition-colors">{t(locale, 'navTools')}</a></li>
          <li><a href={L('/guides/')} class="text-gray-600 hover:text-uma-primary transition-colors">{t(locale, 'navGuides')}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-bold text-sm mb-3 text-gray-800">{t(locale, 'navTools')}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={L('/tools/factor-calculator/')} class="text-gray-600 hover:text-uma-primary transition-colors">{t(locale, 'toolFactor')}</a></li>
          <li><a href={L('/tools/training-calculator/')} class="text-gray-600 hover:text-uma-primary transition-colors">{t(locale, 'toolTraining')}</a></li>
          <li><a href={L('/tools/skill-builder/')} class="text-gray-600 hover:text-uma-primary transition-colors">{t(locale, 'toolSkill')}</a></li>
          <li><a href={L('/tools/support-deck/')} class="text-gray-600 hover:text-uma-primary transition-colors">{t(locale, 'toolDeck')}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-bold text-sm mb-3 text-gray-800">{t(locale, 'footerLegal')}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={L('/privacy-policy/')} class="text-gray-600 hover:text-uma-primary transition-colors">{t(locale, 'privacy')}</a></li>
          <li><a href={L('/terms-of-service/')} class="text-gray-600 hover:text-uma-primary transition-colors">{t(locale, 'terms')}</a></li>
          <li><a href={L('/data-sources/')} class="text-gray-600 hover:text-uma-primary transition-colors">{t(locale, 'dataSources')}</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-200 pt-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-xs text-gray-500">© {new Date().getFullYear()} UmamusumeDB</p>
        <p class="text-xs text-gray-500 text-center">{t(locale, 'footerNotAffiliated')}</p>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    position: relative;
    z-index: 10;
  }
</style>
